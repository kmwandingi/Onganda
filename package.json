{
  "name": "@onganda/design-system",
  "version": "1.2.0",
  "type": "module",
  "description": "Onganda pixel editorial design system \u2014 tokens, primitives, icons, charts, sections, editors, and AI authoring tools for the Namibia AI Systems Lab.",
  "keywords": [
    "design-system",
    "react",
    "pixel-art",
    "namibia",
    "onganda",
    "tailwindcss"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kmwandingi/Onganda.git"
  },
  "bin": {
    "onganda-check": "scripts/onganda-check.mjs"
  },
  "main": "dist/package/index.cjs",
  "module": "dist/package/index.js",
  "types": "dist/package/design-system/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/package/design-system/index.d.ts",
      "import": "./dist/package/index.js",
      "require": "./dist/package/index.cjs"
    },
    "./core": {
      "types": "./dist/package/design-system/core.d.ts",
      "import": "./dist/package/core.js",
      "require": "./dist/package/core.cjs"
    },
    "./charts": {
      "types": "./dist/package/design-system/charts.d.ts",
      "import": "./dist/package/charts.js",
      "require": "./dist/package/charts.cjs"
    },
    "./editors": {
      "types": "./dist/package/design-system/editors.d.ts",
      "import": "./dist/package/editors.js",
      "require": "./dist/package/editors.cjs"
    },
    "./ai": {
      "types": "./dist/package/design-system/ai.d.ts",
      "import": "./dist/package/ai.js",
      "require": "./dist/package/ai.cjs"
    },
    "./maps": {
      "types": "./dist/package/design-system/maps.d.ts",
      "import": "./dist/package/maps.js",
      "require": "./dist/package/maps.cjs"
    },
    "./sites": {
      "types": "./dist/package/design-system/sites.d.ts",
      "import": "./dist/package/sites.js",
      "require": "./dist/package/sites.cjs"
    },
    "./maps.css": "./dist/package/maps.css",
    "./style.css": "./dist/package/style.css",
    "./style": "./dist/package/style.css",
    "./tokens.css": "./dist/package/tokens.css",
    "./tailwind.css": "./dist/package/tailwind.css",
    "./fonts.css": "./dist/package/fonts.css"
  },
  "files": [
    "dist/package",
    "scripts/onganda-check.mjs",
    "scripts/check-design-tokens.mjs",
    "scripts/check-contrast.mjs",
    "tokens",
    "src/components/onganda/onganda-colors.ts",
    "src/components/onganda/onganda-roles.ts",
    "src/components/onganda/onganda-type.ts",
    "README.md",
    "USAGE.md",
    "LICENSE"
  ],
  "sideEffects": [
    "dist/package/maps.css",
    "dist/package/style.css"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && npm run build:showcase && npm run build:lib",
    "build:showcase": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && node scripts/build-layout-css.mjs && node scripts/build-token-css.mjs && cp src/design-system/tokens.css dist/package/tokens.css && cp src/design-system/tailwind.css dist/package/tailwind.css && cp src/design-system/fonts.css dist/package/fonts.css && rm -rf dist/package/fonts && cp -R src/design-system/fonts dist/package/fonts && cat src/design-system/lib-style.css src/design-system/lib-layout.css > dist/package/style.css && cp node_modules/leaflet/dist/leaflet.css dist/package/maps.css && cp -R node_modules/leaflet/dist/images dist/package/images",
    "prepare": "node scripts/stamp-version.mjs && npm run build:lib",
    "lint": "eslint .",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:tokens:export": "node scripts/build-tokens.mjs --check",
    "build:tokens": "node scripts/build-tokens.mjs",
    "check:design": "npm run check:tokens && npm run check:contrast && npm run check:docs && npm run check:tokens:export && npm run check:token-css && npm run check:test-pages && npm run check:fonts",
    "test:package": "node tests/package-smoke.mjs",
    "test:consumer": "node tests/consumer-render.mjs",
    "test:browser": "playwright test",
    "check": "npm run lint && npm run check:design && npm run build && npm run test:package && npm run test:consumer",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:layout": "node scripts/build-layout-css.mjs",
    "reference": "node scripts/capture-reference.mjs",
    "build:token-css": "node scripts/build-token-css.mjs",
    "check:token-css": "node scripts/build-token-css.mjs --check",
    "test-pages": "node scripts/capture-test-pages.mjs",
    "check:test-pages": "node scripts/check-design-tokens.mjs --paths src/test-pages",
    "build:fonts": "node scripts/build-font-css.mjs",
    "check:fonts": "node scripts/build-font-css.mjs --check"
  },
  "peerDependencies": {
    "framer-motion": ">=10.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "recharts": ">=2.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@headless-tree/core": "^1.4.0",
    "@headless-tree/react": "^1.4.0",
    "@hookform/resolvers": "^5.2.1",
    "@react-three/drei": "^10.0.6",
    "@react-three/fiber": "^9.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": ">=10.0.0",
    "input-otp": "^1.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.542.0",
    "next-themes": "^0.4.6",
    "pptxgenjs": "^4.0.1",
    "radix-ui": "^1.4.3",
    "react": ">=18.0.0",
    "react-day-picker": "^9.9.0",
    "react-dom": ">=18.0.0",
    "react-hook-form": "^7.62.0",
    "react-resizable-panels": "^3.0.5",
    "recharts": ">=2.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.175.0",
    "uuid": "^11.1.0",
    "vaul": "^1.1.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.0.9",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "prettier": "3.5.3",
    "tailwindcss": "^4.0.9",
    "tw-animate-css": "^1.3.7",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^5.0.2"
  }
}
