{
  "$description": "Onganda Design System — the complete and closed token set for the Namibia AI Systems Lab. Any colour, size, spacing or radius not in this file is not part of the system. Generated from source by scripts/build-tokens.mjs; do not edit by hand.",
  "palette": {
    "$description": "The nine brand hues and the dark surfaces. These are the raw materials. Do NOT design with them directly — pick a semantic role below. Each entry records what it may and may not do.",
    "milletClay": {
      "$type": "color",
      "$value": "#E8E1CF",
      "$description": "ALLOWED: Light canvas; text and icons on any dark surface; the label on mopane, plum and bark rust fills; the accent hover fill in dark mode. — NEVER: A fill on a light surface — it disappears."
    },
    "dustLight": {
      "$type": "color",
      "$value": "#F3E8C3",
      "$description": "ALLOWED: Lifted surface on the light canvas: cards, panels, bands. — NEVER: Text, borders, or any action."
    },
    "mahanguGold": {
      "$type": "color",
      "$value": "#DFAE2B",
      "$description": "ALLOWED: The accent action fill (8.4:1 with char black) with a mopane edge; the primary hover fill in dark mode; caution status; Ombiga; chart series 3. — NEVER: Light-mode body text or any small type — 1.6:1 on cream. Never millet clay on it."
    },
    "ochreOrange": {
      "$type": "color",
      "$value": "#D9791F",
      "$description": "ALLOWED: A FILL with char black on it (5.5:1): the primary action, checked control, active tab. INK on dark surfaces only (6.1:1): link, focus ring, ghost hover. Also Okaanda. — NEVER: Ink on a light surface — 2.4:1. Use bark rust there. Never body text at any size."
    },
    "firedRed": {
      "$type": "color",
      "$value": "#C84A1B",
      "$description": "ALLOWED: Critical status marks, invalid field borders and the danger button edge, where the 3:1 non-text floor applies. — NEVER: A fill behind small text — its best foreground is 4.05:1. Never error message text. Never a second general-purpose accent."
    },
    "barkRust": {
      "$type": "color",
      "$value": "#8F3E21",
      "$description": "ALLOWED: The accent as INK on light surfaces (5.6:1): link, focus ring, ghost hover, field focus. The danger fill, with millet clay on it; the edge of the primary action. Also Oshini and chart series 2. — NEVER: A surface or a large decorative fill."
    },
    "mopaneBrown": {
      "$type": "color",
      "$value": "#6A4B2E",
      "$description": "ALLOWED: The primary hover fill with millet clay (6.1:1) and the accent edge, light mode only; settled status on light surfaces; Etiti; chart series 4. — NEVER: Picked directly for chrome — read the role. Never on a dark card — 2.25:1. Use mopaneBrownLight."
    },
    "mopaneBrownLight": {
      "$type": "color",
      "$value": "#8F6840",
      "$description": "ALLOWED: Settled status and Etiti on dark surfaces, where the base tone loses contrast. — NEVER: A sixth system color."
    },
    "charBlack": {
      "$type": "color",
      "$value": "#1E1A17",
      "$description": "ALLOWED: Ink: text, and lines via the alpha ramp; the label on ochre and gold fills; inverse surfaces (footer, ticker, lab card); the danger hover fill. — NEVER: The primary action fill — a black primary makes chrome the heaviest thing on the screen. The dark-mode canvas — use darkBg."
    },
    "dyePlum": {
      "$type": "color",
      "$value": "#6F4A6E",
      "$description": "ALLOWED: The accent hover fill with millet clay (5.6:1), light mode; Oshitoo; chart series 5. — NEVER: A status, a surface, or a resting fill."
    },
    "darkBg": {
      "$type": "color",
      "$value": "#120F0D"
    },
    "darkCard": {
      "$type": "color",
      "$value": "#1C1713"
    },
    "darkCardAlt": {
      "$type": "color",
      "$value": "#271F1A"
    }
  },
