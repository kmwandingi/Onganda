  "density": {
    "$description": "How tight a surface is. Density belongs to the SURFACE, not the control: a container declares it once with DensityProvider and every control inside tightens together. Use `comfortable` for pages and `compact` for popups, side panels, toolbars and inspectors. Dropping page density into a 340px panel is what makes a layout read as oversized and cramped.",
    "comfortable": {
      "$type": "other",
      "$value": {
        "Measured": "the",
        "buttonPadding": "12px 24px",
        "buttonFont": 14,
        "fieldPadding": "12px 16px",
        "fieldFont": 14,
        "textareaMinHeight": 128,
        "controlBox": 18,
        "toggleWidth": 40,
        "toggleHeight": 20,
        "stackGap": 20,
        "labelGap": 12,
        "tabPadding": "8px 16px"
      },
      "$description": "Pages and full-width app views. The default."
